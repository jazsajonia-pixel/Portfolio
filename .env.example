# Neon Postgres Database Connection URL
DATABASE_URL="postgresql://neondb_owner:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Contact form email delivery; use a sender at a domain verified in Resend.
RESEND_API_KEY=replace-with-your-server-side-resend-api-key
RESEND_FROM_EMAIL="Portfolio Contact <contact@your-verified-domain.com>"
# Optional; defaults to the address displayed on the Contact page.
CONTACT_EMAIL=jaz.sajonia@gmail.com
